{
  "name": "portfolio-frontend",
  "version": "1.31.0",
  "description": "Portfolio React 19 y DDD",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage --coverageDirectory=coverage",
    "e2e": "playwright test",
    "lint": "eslint . --ext ts,tsx",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "prepare": "husky install",
    "build:android": "npm run build && npx cap sync android && npx cap open android",
    "build:android:prod": "tsc && vite build --mode android && npx cap sync android",
    "build:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npx cap copy"
  },
  "dependencies": {
    "@capacitor/core": "^8.2.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@react-oauth/google": "^0.13.5",
    "@revenuecat/purchases-capacitor": "^13.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.2.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^4.2.1",
    "baseline-browser-mapping": "2.11.26",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^14.0.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.14",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  }
}
