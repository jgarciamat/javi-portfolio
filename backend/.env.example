# Local development settings for the API (copy to backend/.env).
# In production these come from deploy/.env (see deploy/.env.example).

NODE_ENV=development
PORT=3000
# SQLite file (created on first start)
DATABASE_PATH=./data/money-manager.db

# Optional in development (a dev-only secret is used if empty); REQUIRED in production.
JWT_SECRET=

APP_URL=http://localhost:5176

# Google sign-in (same value as VITE_GOOGLE_CLIENT_ID in frontend/.env)
GOOGLE_CLIENT_ID=

# E-mail: without RESEND_API_KEY the verification / reset links are printed in the console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM_NAME=Money Manager

# ── AI (Premium) — optional ──────────────────────────────────────────────────
# Without a provider the analyses use the built-in rules.
# Cloudflare Workers AI: free daily allocation (10,000 neurons/day), no training on
# your data. Token: Cloudflare dashboard → AI → "Use REST API" (Workers AI: Read/Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# true only for models that support JSON mode (e.g. @cf/meta/llama-3.1-8b-instruct)
CLOUDFLARE_AI_JSON_MODE=false
# Neurons per million tokens of the model above (Cloudflare pricing page).
AI_NEURONS_PER_M_INPUT=4119
AI_NEURONS_PER_M_OUTPUT=34868
# Global cap per UTC day, below the free 10,000.
AI_DAILY_NEURON_BUDGET=9000
# Gemini only with a PAID key (the free tier may not serve users in the EEA):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# ── Payments (Stripe) — optional ─────────────────────────────────────────────
# Without them the app works and "Upgrade" is disabled. Use test keys locally and
# forward webhooks with: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=
# Purchases made in the Android app (Google Play, verified by RevenueCat). Put the same
# random value (16+ chars) in RevenueCat > Integrations > Webhooks > Authorization header.
# Webhook URL: https://www.winjgm.com/api/billing/play/webhook
REVENUECAT_WEBHOOK_AUTH=
# Prices shown in the app (VAT included; keep them equal to the Stripe prices).
PRICE_MONTHLY=2.99
PRICE_YEARLY=24.99
PRICE_LIFETIME=49
FOUNDER_LIMIT=100

# ── Partner offers — optional ────────────────────────────────────────────────
# JSON file with the affiliate offers (see config/affiliates.example.json).
AFFILIATES_FILE=

# Backups (optional): directory for `npm run db:backup` and the daily scheduler.
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14

# Demo user for local development only (ignored in production).
SEED_DEMO_USER=false
SEED_DEMO_EMAIL=demo@moneymanager.local
SEED_DEMO_PASSWORD=
