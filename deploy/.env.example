# Copy to deploy/.env on the server. Never commit the real file.

# ── Required ────────────────────────────────────────────────────────────────
# Signs access tokens. Generate one with: openssl rand -base64 48
# The API refuses to start in production without it (or with a published value).
JWT_SECRET=
# Encrypts the two-step verification (TOTP) secrets at rest: openssl rand -base64 48
# Optional (a key is derived from JWT_SECRET when empty), but set it so rotating JWT_SECRET
# does not invalidate the authenticator apps already set up. Never change it afterwards.
TWO_FACTOR_ENCRYPTION_KEY=

# Public URL of the web app (used in e-mail links and CORS). No trailing slash.
APP_URL=https://finanverso.app

# ── Google sign-in ──────────────────────────────────────────────────────────
# Same client id as VITE_GOOGLE_CLIENT_ID in the frontend. Tokens issued to any
# other client are rejected. Without it, "Sign in with Google" is disabled.
GOOGLE_CLIENT_ID=

# ── Error tracking (opt-in) ─────────────────────────────────────────────────
# DSN of a Sentry EU / GlitchTip project for the API. Empty = off (nothing is sent).
# The web app has its own: VITE_SENTRY_DSN in frontend/.env.production. See MONITORIZACION.md.
SENTRY_DSN=

# ── E-mail (Resend) ─────────────────────────────────────────────────────────
# Required in production: the API refuses to start without it (in development the links go to the log).
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@finanverso.app
EMAIL_FROM_NAME=Finanverso

# ── AI (Premium) — Cloudflare Workers AI ────────────────────────────────────
# Runs on Cloudflare's free daily allocation (10,000 neurons/day). Without it the
# analyses use the built-in rules. Token permissions: Workers AI (Read + Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
CLOUDFLARE_AI_JSON_MODE=false
AI_NEURONS_PER_M_INPUT=4119
AI_NEURONS_PER_M_OUTPUT=34868
AI_DAILY_NEURON_BUDGET=9000
# Gemini only with a PAID key (its free tier may not serve users in the EEA):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# Webhook endpoint: https://<your domain>/api/billing/webhook with the events
# checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created/updated/deleted and charge.refunded (a refunded
# founder payment takes Premium back).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# One-time "founder" price (optional; leave empty to hide the lifetime plan).
STRIPE_PRICE_LIFETIME=
# One-time price (10 EUR) of the one-month tax return pass that includes reading a draft
STRIPE_PRICE_RENTA_PASS=
# Purchases made in the Android app (Google Play, verified by RevenueCat). Put the same
# random value (16+ chars) in RevenueCat > Integrations > Webhooks > Authorization header.
# Webhook URL: https://finanverso.app/api/billing/play/webhook
REVENUECAT_WEBHOOK_AUTH=
# Push notifications (browser and installed web app): generate once with
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@finanverso.app
PRICE_MONTHLY=3.49
PRICE_YEARLY=29.99
PRICE_LIFETIME=59
FOUNDER_LIMIT=100

# ── Creator affiliate program (docs/afiliacion) — off by default ─────────────
# Pays creators per first Premium payment of users who signed up with their code
# and agreed to it. Nothing is paid automatically: `npm run creators -- report`.
# Needs the Stripe webhook to also send invoice.paid and charge.dispute.created.
CREATOR_PROGRAM=false
CREATOR_COMMISSION_MONTHLY_EUR=2
CREATOR_COMMISSION_YEARLY_EUR=7
CREATOR_COMMISSION_LIFETIME_EUR=10
# Caps per calendar year: per creator and for the whole program.
CREATOR_CAP_EUR=300
CREATOR_GLOBAL_CAP_EUR=1500
CREATOR_WINDOW_DAYS=90
CREATOR_HOLD_DAYS=45

# ── Optional ────────────────────────────────────────────────────────────────
# Extra allowed origins, comma separated (the web URL and the Android/iOS app
# origins are always allowed).
CORS_ORIGINS=
# Hops of reverse proxies in front of the API (Caddy = 1).
# Fixed to 2 in docker-compose.yml (Cloudflare + Caddy).
TRUST_PROXY=2
# Backups (written to the api_backups volume)
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Receipts forwarded by e-mail (see deploy/email-worker/README.md)
# INBOUND_EMAIL_DOMAIN=facturas.finanverso.app
# INBOUND_EMAIL_SECRET=change-me-with-at-least-16-characters
