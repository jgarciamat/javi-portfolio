# Copy to deploy/.env on the server. Never commit the real file.

# ── Required ────────────────────────────────────────────────────────────────
# Signs access tokens. Generate one with: openssl rand -base64 48
# The API refuses to start in production without it (or with a published value).
JWT_SECRET=

# Public URL of the web app (used in e-mail links and CORS). No trailing slash.
APP_URL=https://www.winjgm.com

# ── Google sign-in ──────────────────────────────────────────────────────────
# Same client id as VITE_GOOGLE_CLIENT_ID in the frontend. Tokens issued to any
# other client are rejected. Without it, "Sign in with Google" is disabled.
GOOGLE_CLIENT_ID=

# ── E-mail (Resend) ─────────────────────────────────────────────────────────
# Without a key, e-mails are only written to the API log.
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@winjgm.com
EMAIL_FROM_NAME=Money Manager

# ── AI (Premium) — Cloudflare Workers AI ────────────────────────────────────
# Runs on Cloudflare's free daily allocation (10,000 neurons/day). Without it the
# analyses use the built-in rules. Token permissions: Workers AI (Read + Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
CLOUDFLARE_AI_JSON_MODE=false
AI_NEURONS_PER_M_INPUT=4119
AI_NEURONS_PER_M_OUTPUT=34868
AI_DAILY_NEURON_BUDGET=9000
# Gemini only with a PAID key (its free tier may not serve users in the EEA):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# Webhook endpoint: https://<your domain>/api/billing/webhook with the events
# checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# One-time "founder" price (optional; leave empty to hide the lifetime plan).
STRIPE_PRICE_LIFETIME=
PRICE_MONTHLY=2.99
PRICE_YEARLY=24.99
PRICE_LIFETIME=49
FOUNDER_LIMIT=100

# ── Optional ────────────────────────────────────────────────────────────────
# Extra allowed origins, comma separated (the web URL and the Android/iOS app
# origins are always allowed).
CORS_ORIGINS=
# Hops of reverse proxies in front of the API (Caddy = 1).
TRUST_PROXY=1
# Backups (written to the api_backups volume)
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
