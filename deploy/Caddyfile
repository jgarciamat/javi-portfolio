# Cloudflare sits in front of the sites. Only its edges (https://www.cloudflare.com/ips/) may pass
# X-Forwarded-For through; for anyone else Caddy replaces it with the real peer address, so a client
# that reaches the server directly cannot fake its IP. The API trusts two hops (Caddy + Cloudflare).
{
  servers {
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    client_ip_headers CF-Connecting-IP X-Forwarded-For
  }
}

# The app lives at finanverso.app. winjgm.com is the old domain: the pages redirect to the new one,
# but /api keeps working there because installed Android apps (v30 and older) call https://www.winjgm.com/api.
(app) {

  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # CSP, in two layers (see deploy/CSP.md):
    #  1. Enforced now: the directives that cannot break the app (no plugins, fixed <base>, forms
    #     only to ourselves, nobody frames us, http sub-resources upgraded).
    #  2. The full policy (scripts, styles, connections, images...) stays Report-Only until the
    #     reports at /api/csp-report show no violation from real users; then move it, as it is,
    #     to Content-Security-Policy. Google sign-in and the click-to-load YouTube player
    #     (youtube-nocookie.com, only after a click) are the only third-party origins.
    Reporting-Endpoints `csp-endpoint="/api/csp-report"`
    Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com https://apis.google.com; worker-src 'self' blob:; frame-src https://accounts.google.com https://www.youtube-nocookie.com; connect-src 'self' https://accounts.google.com https://www.googleapis.com https://oauth2.googleapis.com; img-src 'self' data: blob: https://*.googleusercontent.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp-report; report-to csp-endpoint"
    -Server
  }

  handle /api/* {
    request_body {
      max_size 5MB
    }
    reverse_proxy api:3000
  }

  handle {
    reverse_proxy web:80
  }
}

finanverso.app {
  import app
}

www.finanverso.app {
  redir https://finanverso.app{uri} permanent
}

www.winjgm.com {
  handle /api/* {
    request_body {
      max_size 5MB
    }
    reverse_proxy api:3000
  }

  handle {
    redir https://finanverso.app{uri} permanent
  }
}

winjgm.com {
  redir https://finanverso.app{uri} permanent
}
